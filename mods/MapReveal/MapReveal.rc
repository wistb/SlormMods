#include <winver.h>
#include "source/Version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MAPREVEAL_MAJOR, MAPREVEAL_MINOR, MAPREVEAL_PATCH, 0
PRODUCTVERSION MAPREVEAL_MAJOR, MAPREVEAL_MINOR, MAPREVEAL_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "Map Reveal"
			VALUE "FileVersion", MAPREVEAL_VERSION
			VALUE "ProductName", "Map Reveal"
			VALUE "ProductVersion", MAPREVEAL_VERSION
			VALUE "OriginalFilename", "MapReveal.dll"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
